// Stim Bench Exact: the view. app.ts answers what it asks for.
shape Greeting
  text: string

routes nav
  home "/"

component StimBenchExact
  resource greeting = greeting("Stim Bench Exact") as shape Greeting
  state count = 0
  action increment
    count = count + 1
  view
    main testId="root" navigationKey=`${top(nav).id}` navigationBack="back" width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationScroll="content" position="absolute" inset=0 display="flex" flex-direction="column"
          header display="flex" align-items="center"
            text "Stim Bench Exact" role="heading" aria-level=1 flex=1
          scroll id="content" flex=1 min-height=0 padding=16
            if failed(greeting)
              text "The app failed to start." testId="startup-failed"
            else
              column gap=12
                text "native-revision-one" testId="revision"
                text `Count: ${count}` testId="count"
                button press=increment testId="increment"
                  text "Increment"
                text greeting.text testId="greeting"
